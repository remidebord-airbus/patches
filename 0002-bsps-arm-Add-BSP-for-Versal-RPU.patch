+ * @ingroup RTEMSBSPsARMVersalRPU
+ *
+ * @brief This source file contains the implementation of bsp_start_hook_0().
+ */
+
+/*
+ * Copyright (C) 2024 embedded brains GmbH & Co. KG
+ * Copyright (C) 2023 Reflex Aerospace GmbH
